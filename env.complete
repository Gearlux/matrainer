# matrainer: the Keras backend, MLFLOW system metrics, MPS memory limits and the roots a run's paths are recorded against

# -- Tracking
# MLFLOW_TRACKING_URI=http://127.0.0.1:5005   the MLflow server a run is stored on when its tracker names none (MlflowTracker's tracking_uri); unset means MLflow's own default, a local ./mlruns folder, which MLflow 3.15 and later refuse unless MLFLOW_ALLOW_FILE_STORE=true (README.md → Environment variables)
# MLFLOW_SYSTEM_METRICS_SAMPLING_INTERVAL=10   seconds between system-metric samples (README.md → system metrics)
# PROJECT_ROOT=/path/to/workspace   root of the code; paths under it are recorded as $PROJECT_ROOT/... in the run manifest (README.md → portable manifests)
# DATA_ROOT=/path/to/datasets   root of the datasets; paths under it are recorded as $DATA_ROOT/...
# MODEL_ROOT=/path/to/models   root of the models; paths under it are recorded as $MODEL_ROOT/...
# AIM_REPO=/path/to/aim   Aim repository; written by the Aim service, read as $AIM_REPO by run configs (README.md → Aim)

# -- Frameworks
# KERAS_BACKEND=tensorflow   tensorflow | torch | jax — Keras 3 backend; matrainer.tensorflow and --framework tensorflow default it to tensorflow
# PYTORCH_MPS_HIGH_WATERMARK_RATIO=   Apple GPU: fraction of memory the allocator may use; set before the process starts, matrainer sets it from the device options when unset
# PYTORCH_MPS_LOW_WATERMARK_RATIO=   Apple GPU: fraction of memory the allocator keeps free; same rule

# not for .env: CLEARML_API_ACCESS_KEY CLEARML_API_SECRET_KEY CLEARML_USERNAME CLEARML_PASSWORD — written to .env by the ClearML service when it starts
